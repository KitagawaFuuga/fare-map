# 駅すぱあと API フリープランのアクセスキー（未設定なら Google Maps リンクにフォールバック）
EKISPERT_API_KEY=

# レート制限: 1 IP が瞬間的に出せるリクエスト数。設定すると、下の API のすべてで同じ値になる
#   /api/reachable: 既定 20、定常 0.5 req/s（app/api/reachable/config.ts）
#   /api/stations:  既定 30、定常 2 req/s（app/api/stations/config.ts）
RATE_LIMIT_CAPACITY=

# 同じ (出発駅, 予算) の探索結果を使い回す件数（既定 200）
REACHABLE_CACHE_ENTRIES=
