{
  "ci": {
    "collect": {
      "startServerCommand": "node node_modules/next/dist/bin/next start -p 3200",
      "startServerReadyPattern": "Ready",
      "url": ["http://127.0.0.1:3200/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "warn",
          { "maxNumericValue": 2500, "aggregationMethod": "median-run" }
        ],
        "cumulative-layout-shift": [
          "warn",
          { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }
        ],
        "total-blocking-time": [
          "warn",
          { "maxNumericValue": 200, "aggregationMethod": "median-run" }
        ],
        "categories:performance": [
          "warn",
          { "minScore": 0.9, "aggregationMethod": "median-run" }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
