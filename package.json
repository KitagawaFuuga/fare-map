{
  "name": "fare-map",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pipeline:fetch": "tsx scripts/pipeline/fetch-data.ts && tsx scripts/pipeline/fetch-kilometrage.ts",
    "pipeline:fetch-km": "tsx scripts/pipeline/fetch-kilometrage.ts",
    "pipeline:build": "tsx scripts/pipeline/build-graph.ts",
    "pipeline:validate": "tsx scripts/pipeline/validate-graph.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lighthouse": "lhci autorun"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "maplibre-gl": "^6.19.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@nizos/probity": "^1.10.1",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.26",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@stryker-mutator/core": {
      "minimatch": "^11.0.5"
    },
    "typed-rest-client": {
      "qs": "^6.16.1"
    }
  }
}
